# Projeto
PROJECT_NAME           = "Hotelaria"
PROJECT_NUMBER         = 1.0
PROJECT_BRIEF          = "Sistema de Gerenciamento de Hotéis - UNB"
OUTPUT_DIRECTORY       = docs
OUTPUT_LANGUAGE        = Brazilian

# Entrada
INPUT                  = include src libs testes
FILE_PATTERNS          = *.cpp *.hpp *.h
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */cmake-build-debug/* */CMakeFiles/*

USE_MDFILE_AS_MAINPAGE = README.md
INPUT += README.md AUTHORS.md 

# Extração de membros
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_LOCAL_METHODS  = YES
EXTRACT_ANON_NSPACES   = YES
EXTRACT_PACKAGE        = YES
EXTRACT_PRIV_VIRTUAL   = YES

# Visibilidade
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_UNDOC_NAMESPACES  = NO
INHERIT_DOCS           = YES

# Estilo de comentários
JAVADOC_AUTOBRIEF      = YES
MULTILINE_CPP_IS_BRIEF = YES
QT_AUTOBRIEF           = NO
MARKDOWN_SUPPORT       = YES
MARKDOWN_STRICT        = YES
TOC_INCLUDE_HEADINGS   = 6

# Diagramas
HAVE_DOT               = YES
CLASS_DIAGRAMS         = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
COLLABORATION_GRAPH    = YES
GROUP_GRAPHS           = YES
DIRECTORY_GRAPH        = YES
DOT_IMAGE_FORMAT       = png
DOT_TRANSPARENT        = YES
DOT_MULTI_TARGETS      = YES
DOT_CLEANUP            = YES

# HTML e LaTeX
GENERATE_HTML          = YES
GENERATE_LATEX         = YES
GENERATE_MAN           = YES
GENERATE_RTF           = YES
GENERATE_XML           = YES
PROJECT_LOGO = meta/logo.svg

# Tema Doxygen Awesome (opcional)
HTML_EXTRA_STYLESHEET  = meta/doxygen_tema_awesome/doxygen-awesome.css \
                         meta/doxygen_tema_awesome/doxygen-awesome-sidebar-only.css

HTML_EXTRA_FILES       = meta/doxygen_tema_awesome/doxygen-awesome-darkmode-toggle.js \
                         meta/doxygen_tema_awesome/doxygen-awesome-fragment-copy-button.js \
                         meta/doxygen_tema_awesome/doxygen-awesome-interactive-toc.js \
                         meta/doxygen_tema_awesome/doxygen-awesome-paragraph-link.js

HTML_HEADER            = meta/doxygen_tema_awesome/doxygen_custom/header.html
HTML_COLORSTYLE        = LIGHT

# Outros
WARNINGS               = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO
TAB_SIZE               = 4
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        =
CASE_SENSE_NAMES       = NO
